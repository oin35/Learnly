{
  "name": "learnly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audio:texts": "tsx scripts/audio-texts.ts",
    "build:artifact": "npm run build:single && python3 scripts/make-artifact-page.py",
    "smoke": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
